<Project Sdk="Microsoft.NET.Sdk.Web">

	<PropertyGroup>
		<TargetFramework>net9.0</TargetFramework>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<RootNamespace>Astrolo</RootNamespace>
		<AssemblyName>Astrolo</AssemblyName>
	</PropertyGroup>


	<!-- Exclude MAUI platform-specific files from web build -->
	<ItemGroup>
		<Compile Remove="Platforms\**\*.cs" />
		<Compile Remove="App.xaml.cs" />
		<Compile Remove="AppShell.xaml.cs" />
		<Compile Remove="MainPage.xaml.cs" />
		<Compile Remove="MauiProgram.cs" />
	</ItemGroup>

	<ItemGroup>
		<None Remove="Platforms\**\*" />
		<None Remove="App.xaml" />
		<None Remove="AppShell.xaml" />
		<None Remove="MainPage.xaml" />
		<None Remove="Resources\**\*" />
	</ItemGroup>

</Project>
