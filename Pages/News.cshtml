@page
@model NewsModel
@{
    ViewData["Title"] = "News";
}

<div class="container">
    <div class="section-header">
        <h1 class="section-title">Breaking Space News</h1>
        <p class="section-subtitle">Latest updates from space exploration, missions, and astronomical discoveries</p>
    </div>

    <div class="article-grid">
        <article class="article-card featured-article">
            <div class="article-image">
                <span>🚀</span>
            </div>
            <div class="article-content">
                <div class="article-category">Breaking News</div>
                <h3 class="article-title">NASA Announces New Moon Mission for 2026</h3>
                <p class="article-excerpt">NASA has revealed plans for its next major lunar mission, aiming to establish a permanent human presence on the Moon by the end of the decade.</p>
                <div class="article-meta">
                    <span>1 hour ago</span>
                    <span>By News Team</span>
                </div>
            </div>
        </article>

        <article class="article-card">
            <div class="article-image">
                <span>🛰️</span>
            </div>
            <div class="article-content">
                <div class="article-category">Commercial Space</div>
                <h3 class="article-title">Blue Origin Successfully Tests New Rocket Engine</h3>
                <p class="article-excerpt">Jeff Bezos' space company achieves a major milestone with successful testing of its next-generation BE-4 engine.</p>
                <div class="article-meta">
                    <span>3 hours ago</span>
                    <span>By Launch Team</span>
                </div>
            </div>
        </article>

        <article class="article-card">
            <div class="article-image">
                <span>🌍</span>
            </div>
            <div class="article-content">
                <div class="article-category">Earth Observation</div>
                <h3 class="article-title">New Satellite Provides Unprecedented View of Climate Change</h3>
                <p class="article-excerpt">Latest Earth observation satellite delivers high-resolution data showing rapid changes in global climate patterns.</p>
                <div class="article-meta">
                    <span>6 hours ago</span>
                    <span>By Science Team</span>
                </div>
            </div>
        </article>

        <article class="article-card">
            <div class="article-image">
                <span>🔭</span>
            </div>
            <div class="article-content">
                <div class="article-category">Telescopes</div>
                <h3 class="article-title">Hubble Space Telescope Returns to Full Operations</h3>
                <p class="article-excerpt">After a brief maintenance period, the iconic space telescope is back online and capturing stunning new images of distant galaxies.</p>
                <div class="article-meta">
                    <span>12 hours ago</span>
                    <span>By Telescope Team</span>
                </div>
            </div>
        </article>

        <article class="article-card">
            <div class="article-image">
                <span>🪐</span>
            </div>
            <div class="article-content">
                <div class="article-category">Planetary Science</div>
                <h3 class="article-title">Venus Mission Discovers Active Volcanism</h3>
                <p class="article-excerpt">New data from the Venus exploration mission reveals evidence of recent volcanic activity on the planet's surface.</p>
                <div class="article-meta">
                    <span>1 day ago</span>
                    <span>By Planetary Team</span>
                </div>
            </div>
        </article>

        <article class="article-card">
            <div class="article-image">
                <span>⭐</span>
            </div>
            <div class="article-content">
                <div class="article-category">Astronomy</div>
                <h3 class="article-title">Astronomers Discover Fastest-Rotating Star</h3>
                <p class="article-excerpt">Scientists have identified a star that completes a full rotation in just 16 minutes, breaking previous records.</p>
                <div class="article-meta">
                    <span>2 days ago</span>
                    <span>By Astronomy Team</span>
                </div>
            </div>
        </article>
    </div>
</div>

