@page
@model BuyingGuidesModel
@{
    ViewData["Title"] = "Buying Guides";
}

<div class="container">
    <div class="section-header">
        <h1 class="section-title">Buying Guides & Reviews</h1>
        <p class="section-subtitle">Expert reviews and recommendations for telescopes, cameras, and astronomy equipment</p>
    </div>

    <div class="article-grid">
        <article class="article-card featured-article">
            <div class="article-image">
                <span>🔭</span>
            </div>
            <div class="article-content">
                <div class="article-category">Telescopes</div>
                <h3 class="article-title">Best Telescopes for Beginners in 2025</h3>
                <p class="article-excerpt">Our comprehensive guide reviews the top 10 beginner telescopes, from budget-friendly options to mid-range models. We cover refractors, reflectors, and compound telescopes, with detailed pros and cons for each.</p>
                <div class="article-meta">
                    <span>Updated Weekly</span>
                    <span>Review Team</span>
                </div>
            </div>
        </article>

        <article class="article-card">
            <div class="article-image">
                <span>📷</span>
            </div>
            <div class="article-content">
                <div class="article-category">Astrophotography</div>
                <h3 class="article-title">Best Cameras for Astrophotography</h3>
                <p class="article-excerpt">Compare DSLR, mirrorless, and dedicated astronomy cameras. Learn which features matter most for capturing deep sky objects, planets, and wide-field nightscapes.</p>
                <div class="article-meta">
                    <span>Expert Review</span>
                    <span>Photo Team</span>
                </div>
            </div>
        </article>

        <article class="article-card">
            <div class="article-image">
                <span>👁️</span>
            </div>
            <div class="article-content">
                <div class="article-category">Binoculars</div>
                <h3 class="article-title">Top Astronomy Binoculars Under $200</h3>
                <p class="article-excerpt">Discover the best binoculars for stargazing on a budget. Perfect for beginners who want to explore the night sky before investing in a telescope.</p>
                <div class="article-meta">
                    <span>Budget Guide</span>
                    <span>Review Team</span>
                </div>
            </div>
        </article>

        <article class="article-card">
            <div class="article-image">
                <span>📱</span>
            </div>
            <div class="article-content">
                <div class="article-category">Apps & Software</div>
                <h3 class="article-title">Essential Astronomy Apps for 2025</h3>
                <p class="article-excerpt">Review of the best mobile apps for stargazing, planet identification, and astrophotography planning. Includes free and premium options for iOS and Android.</p>
                <div class="article-meta">
                    <span>App Review</span>
                    <span>Tech Team</span>
                </div>
            </div>
        </article>

        <article class="article-card">
            <div class="article-image">
                <span>🎒</span>
            </div>
            <div class="article-content">
                <div class="article-category">Accessories</div>
                <h3 class="article-title">Must-Have Stargazing Accessories</h3>
                <p class="article-excerpt">From red-light flashlights to star charts and observing chairs, discover the accessories that will enhance your stargazing experience.</p>
                <div class="article-meta">
                    <span>Accessory Guide</span>
                    <span>Review Team</span>
                </div>
            </div>
        </article>

        <article class="article-card">
            <div class="article-image">
                <span>💡</span>
            </div>
            <div class="article-content">
                <div class="article-category">Lighting</div>
                <h3 class="article-title">Best Red Light Flashlights for Astronomy</h3>
                <p class="article-excerpt">Preserve your night vision with these top-rated red light flashlights. Essential for reading star charts and navigating in the dark without ruining your dark adaptation.</p>
                <div class="article-meta">
                    <span>Gear Review</span>
                    <span>Review Team</span>
                </div>
            </div>
        </article>
    </div>
</div>

