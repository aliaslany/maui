@page
@model NightSkyModel
@{
    ViewData["Title"] = "Night Sky";
}

<div class="container">
    <div class="section-header">
        <h1 class="section-title">Night Sky Guide</h1>
        <p class="section-subtitle">Discover what's visible in the night sky tonight and plan your stargazing adventures</p>
    </div>

    <div class="article-grid">
        <article class="article-card featured-article">
            <div class="article-image">
                <span>🌙</span>
            </div>
            <div class="article-content">
                <div class="article-category">Tonight's Sky</div>
                <h3 class="article-title">January 2025 Night Sky Highlights</h3>
                <p class="article-excerpt">This month features the Quadrantid meteor shower peak, Jupiter and Saturn visible in the evening sky, and excellent viewing conditions for the Orion Nebula. The Moon will be in its waxing gibbous phase, providing good illumination for stargazing.</p>
                <div class="article-meta">
                    <span>Updated Daily</span>
                    <span>Sky Guide Team</span>
                </div>
            </div>
        </article>

        <article class="article-card">
            <div class="article-image">
                <span>🪐</span>
            </div>
            <div class="article-content">
                <div class="article-category">Planets</div>
                <h3 class="article-title">Visible Planets This Week</h3>
                <p class="article-excerpt">Jupiter: Visible in the evening sky, brightest object after sunset. Saturn: Low in the western sky after dusk. Mars: Rising in the early morning hours. Venus: Too close to the Sun to observe this week.</p>
                <div class="article-meta">
                    <span>Weekly Update</span>
                    <span>Planetary Guide</span>
                </div>
            </div>
        </article>

        <article class="article-card">
            <div class="article-image">
                <span>⭐</span>
            </div>
            <div class="article-content">
                <div class="article-category">Constellations</div>
                <h3 class="article-title">Constellation of the Month: Orion</h3>
                <p class="article-excerpt">The iconic winter constellation is now at its peak visibility. Look for the three stars of Orion's Belt and explore the Great Orion Nebula with binoculars or a small telescope.</p>
                <div class="article-meta">
                    <span>Monthly Feature</span>
                    <span>Constellation Guide</span>
                </div>
            </div>
        </article>

        <article class="article-card">
            <div class="article-image">
                <span>🌠</span>
            </div>
            <div class="article-content">
                <div class="article-category">Meteor Showers</div>
                <h3 class="article-title">Quadrantid Meteor Shower Peak</h3>
                <p class="article-excerpt">The Quadrantids peak on January 3-4, 2025, with up to 120 meteors per hour under ideal conditions. Best viewing is after midnight in the northern hemisphere.</p>
                <div class="article-meta">
                    <span>Peak: Jan 3-4</span>
                    <span>Meteor Guide</span>
                </div>
            </div>
        </article>

        <article class="article-card">
            <div class="article-image">
                <span>🌍</span>
            </div>
            <div class="article-content">
                <div class="article-category">Aurora</div>
                <h3 class="article-title">Northern Lights Forecast</h3>
                <p class="article-excerpt">Increased solar activity this week may produce visible aurora displays in northern latitudes. Check your local forecast for best viewing times and cloud conditions.</p>
                <div class="article-meta">
                    <span>Updated Hourly</span>
                    <span>Aurora Forecast</span>
                </div>
            </div>
        </article>

        <article class="article-card">
            <div class="article-image">
                <span>🌑</span>
            </div>
            <div class="article-content">
                <div class="article-category">Moon Phases</div>
                <h3 class="article-title">Current Moon Phase: Waxing Gibbous</h3>
                <p class="article-excerpt">The Moon is currently 78% illuminated and growing. Full Moon occurs on January 13, 2025. This phase provides good illumination for evening stargazing but may wash out fainter objects.</p>
                <div class="article-meta">
                    <span>Daily Update</span>
                    <span>Lunar Calendar</span>
                </div>
            </div>
        </article>
    </div>
</div>

