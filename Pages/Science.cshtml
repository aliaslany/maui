@page
@model ScienceModel
@{
    ViewData["Title"] = "Science";
}

<div class="container">
    <div class="section-header">
        <h1 class="section-title">Space Science & Research</h1>
        <p class="section-subtitle">In-depth scientific articles, discoveries, and research from the cosmos</p>
    </div>

    <div class="article-grid">
        <article class="article-card featured-article">
            <div class="article-image">
                <span>🌌</span>
            </div>
            <div class="article-content">
                <div class="article-category">Astrophysics</div>
                <h3 class="article-title">Dark Matter Mystery Deepens with New Observations</h3>
                <p class="article-excerpt">Latest observations from the James Webb Space Telescope challenge existing theories about dark matter distribution in the universe.</p>
                <div class="article-meta">
                    <span>4 hours ago</span>
                    <span>By Physics Team</span>
                </div>
            </div>
        </article>

        <article class="article-card">
            <div class="article-image">
                <span>🔬</span>
            </div>
            <div class="article-content">
                <div class="article-category">Exoplanets</div>
                <h3 class="article-title">New Study Reveals Potential for Life on Ocean Worlds</h3>
                <p class="article-excerpt">Research suggests that subsurface oceans on moons like Europa and Enceladus may harbor conditions suitable for life.</p>
                <div class="article-meta">
                    <span>8 hours ago</span>
                    <span>By Astrobiology Team</span>
                </div>
            </div>
        </article>

        <article class="article-card">
            <div class="article-image">
                <span>⚛️</span>
            </div>
            <div class="article-content">
                <div class="article-category">Quantum Physics</div>
                <h3 class="article-title">Quantum Entanglement Observed Across Cosmic Distances</h3>
                <p class="article-excerpt">Groundbreaking experiment demonstrates quantum entanglement between particles separated by astronomical distances.</p>
                <div class="article-meta">
                    <span>1 day ago</span>
                    <span>By Quantum Team</span>
                </div>
            </div>
        </article>

        <article class="article-card">
            <div class="article-image">
                <span>🌠</span>
            </div>
            <div class="article-content">
                <div class="article-category">Cosmology</div>
                <h3 class="article-title">New Model Suggests Universe May Be Older Than Previously Thought</h3>
                <p class="article-excerpt">Revolutionary cosmological model proposes the universe could be billions of years older than current estimates.</p>
                <div class="article-meta">
                    <span>2 days ago</span>
                    <span>By Cosmology Team</span>
                </div>
            </div>
        </article>

        <article class="article-card">
            <div class="article-image">
                <span>🔭</span>
            </div>
            <div class="article-content">
                <div class="article-category">Observational Astronomy</div>
                <h3 class="article-title">Gravitational Lensing Reveals Distant Galaxy Cluster</h3>
                <p class="article-excerpt">Astronomers use Einstein's theory of relativity to observe one of the most distant galaxy clusters ever detected.</p>
                <div class="article-meta">
                    <span>3 days ago</span>
                    <span>By Observation Team</span>
                </div>
            </div>
        </article>

        <article class="article-card">
            <div class="article-image">
                <span>🧬</span>
            </div>
            <div class="article-content">
                <div class="article-category">Astrobiology</div>
                <h3 class="article-title">Mars Sample Return Mission Prepares for Launch</h3>
                <p class="article-excerpt">NASA and ESA collaborate on ambitious mission to bring Martian soil samples back to Earth for detailed analysis.</p>
                <div class="article-meta">
                    <span>4 days ago</span>
                    <span>By Mission Team</span>
                </div>
            </div>
        </article>
    </div>
</div>

